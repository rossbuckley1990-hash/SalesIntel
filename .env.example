# Backend configuration
APP_ENV=local
DATABASE_URL=sqlite:///./misi.db
# PostgreSQL example for staging or production:
# DATABASE_URL=postgresql://misi_user:change-me@localhost:5432/misi
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_BYTES=5242880

# Backend-only OpenAI configuration. Leave blank until real credentials are provided locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
OPENAI_REQUEST_TIMEOUT_SECONDS=45

# Public research provider: openai (default) or anthropic. Anthropic requires a
# compatible model and key with web search enabled. Keys never go to the browser.
RESEARCH_PROVIDER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional dedicated local source-discovery server. Use a loopback IP, MCP path and
# an access token; keep the server isolated and bind it only to loopback.
RIGHTCLICK_X_URL=
RIGHTCLICK_X_TOKEN=

# Frontend public configuration. Values prefixed with NEXT_PUBLIC are visible in the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: official Companies House company-profile API (do not commit real keys)
COMPANIES_HOUSE_API_KEY=
